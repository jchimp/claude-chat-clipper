{
  "manifest_version": 3,
  "name": "Obsidian Chat Clipper",
  "version": "0.1.0",
  "description": "Capture Claude.ai and Copilot conversations as clean Markdown, pre-scaffolded for your Obsidian notes.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://m365.cloud.microsoft/*",
    "https://*.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip this chat to Obsidian",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
